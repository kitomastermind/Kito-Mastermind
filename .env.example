# --- Supabase (human fills from project settings) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never NEXT_PUBLIC
SUPABASE_DB_URL=                    # for the CLI and the seed script

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production / social preview: https://kito-mastermind.onrender.com
CRON_SECRET=                        # random 32 bytes, guards /api/cron/*
ENCRYPTION_KEY=                     # 32-byte base64, encrypts CRM tokens at rest

# --- Email (Resend; required for invitations, alerts, digest, statements) ---
RESEND_API_KEY=
EMAIL_FROM="KITO Mastermind <no-reply@yourdomain.co.ke>"

# --- Storage ---
SUPABASE_STORAGE_BUCKET=kito-files

# --- M-Pesa Daraja (Phase 5) ---
MPESA_ENABLED=false
MPESA_ENV=sandbox                   # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# --- Observability ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
